# Content Studio backend API URLs.
# Copy this file to `.env` and set the value to your backend.
# Demo data is never selected automatically when the backend fails.

# Existing LinkedIn content API and social publishing API.
VITE_LINKEDIN_API_BASE_URL=/api/v3/linkedin
VITE_SOCIAL_API_BASE_URL=/api/v3/social

# Backend origin used by the Vite development proxy for /api and /media.
# Set this to your public HTTPS backend tunnel when the backend is remote.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Explicitly opt into bundled Content Studio demo data.
VITE_DEMO_MODE=false

