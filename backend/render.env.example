# Copy these values into the Render web service Environment page.
# Do not commit real credentials. Keep the same DJANGO_SECRET_KEY if importing
# an existing database containing signed application data.
DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ALLOWED_HOSTS=content-studio-wbb3.onrender.com

# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Copy the complete URI from Supabase; URL-encode special characters in passwords.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0

# Render Key Value -> Connect -> Internal URL (same workspace and region).
REDIS_URL=redis://REPLACE_WITH_RENDER_INTERNAL_URL
PUBLIC_BACKEND_URL=https://content-studio-wbb3.onrender.com

# Deployed Cloudflare Pages frontend.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://content-studio-5m7.pages.dev
CSRF_TRUSTED_ORIGINS=https://content-studio-5m7.pages.dev
CONTENT_STUDIO_FRONTEND_ORIGINS=https://content-studio-5m7.pages.dev
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
CONTENT_AUTOMATION_DEV_BOOTSTRAP=False
BILLING_SIMULATED_CHECKOUT_ENABLED=False
# Comma-separated emails, or * to allow every authenticated billing manager.
BILLING_SIMULATED_CHECKOUT_ALLOWED_EMAILS=
BILLING_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET

# Direct Assistance form. For Gmail, generate an app password after enabling
# two-step verification; do not use the normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=visiofytech@gmail.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Visiofy Studio <visiofytech@gmail.com>
SUPPORT_EMAIL=visiofytech@gmail.com

# Zernio is used for every Content Studio social network. Add the two secret
# values to the web service; Blueprint workers inherit them from it.
SOCIAL_PUBLISHER_DEFAULT=ZERNIO
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_API_KEY=REPLACE_WITH_ZERNIO_API_KEY
ZERNIO_WEBHOOK_SECRET=REPLACE_WITH_ZERNIO_WEBHOOK_SECRET
ZERNIO_CONNECTION_RETURN_URL=https://content-studio-5m7.pages.dev/content/connections

# Also copy the AI and image-provider keys used by the working local backend
# into Render's Environment page.
# This template does not configure durable social media storage.
